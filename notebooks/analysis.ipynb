      "source": [
        "# Maze Solver Analysis\nLearning curves, BFS comparison maze_solver/utils.py:3 with confidence intervals over 5 seeds (evaluate.py:3)\n",
        "Learning curves, BFS comparison with confidence intervals over 5 seeds"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "from maze_solver.env import MazeEnv\nfrom maze_solver.agents import QLearningAgent\nfrom train import train\nfrom evaluate import evaluate\nfrom maze_solver.utils import bfs\nimport numpy as np\n"
      ],
      "outputs": [],
      "execution_count": null
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "seeds=[0,1,2,3,4]\nall_success=[]\nfor s in seeds:\n    env=MazeEnv(size=5, seed=s)\n    agent=QLearningAgent(env.observation_space.n, env.action_space.n)\n    train(agent, env, episodes=500, seed=s)\n    res=evaluate(agent, env, episodes=20, seed=s)\n    all_success.append(res['success'])\nprint(f\"mean success {np.mean(all_success):.2f} +/- {np.std(all_success):.2f}\")\n"
      ],
      "outputs": [],
      "execution_count": null
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "from plot import plot_rewards, plot_q_heatmap\n# plot_rewards example\n"
      ],
      "outputs": [],
      "execution_count": null
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## BFS Optimal vs Learned\n",
        "BFS 5x5 optimal = 8 steps"
